{
  "exp_name": "UCF Experiment",
  "agent": "Agent",
  "mode": "train",
  "num_classes": 51,
  "training_params": {
    "cuda": true,
    "gpu_device": [1],
    "seed": 109,
    "batch_size": 32,
    "test_batch_size": 32,
    "data_loader_workers": 8,
    "pin_memory": true,
    "async_loading": true,
    "validation": true,
    "rec_test": true,
    "test_on_bottoms": false,
    "use_test_set": true,
    "verbose": true,
    "adversarial_training": {
      "use": false,
      "adv_epsilon": 0.01
    },
    "tdqm_disable": false,
    "wandb_disable":false,
    "res": true
  },
  "scheduler": {"type":"cosanneal", "max_lr": 0.03, "warm_up_steps": 780},
  "optimizer": {
    "type": "Adam",
    "learning_rate": 0.001,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "beta1": 0.9,
    "beta2": 0.999
  },
  "lr_finder": false,
  "lr_finder_steps": 100,
  "early_stopping": {
    "max_epoch": 100,
    "end_of_epoch_check": true,
    "log_interval": 10,
    "save_every_valstep": 1,
    "validate_every": 127,
    "validate_after": 0,
    "n_steps_stop": 100,
    "n_steps_stop_after": 0,
    "validate_with": "accuracy"
  },
  "dataset": {
      "dataloader_class": "UCF_Dataloader",
      "data_roots": "/home/xinyu9981/data/ucf",
      "data_split": {
        "fold": 1
      },
      "fps": 1,
      "num_frame": 4
  },
  "model": {
    "save_base_dir": "/home/xinyu9981/exp/ucf"
  }
}