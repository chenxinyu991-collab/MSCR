{
  "model": {
    "model_class": "MCR_Model_FSR",
    "args": {
      "d_model": 512,
      "num_classes": 28,
      "fc_inner": 64,
      "dropout": 0.1,
      "shared_pred": true,
      "cls_type": "linear",
      "clip_grad": false,
      "shufflegradmulti": true,
      "bias_infusion": {
        "method": "MCR_FSR",
        "reg_by": "dist_pred_cjsd",
        "num_samples": 6,
        "l": 0.1,
        "shuffle": true,
        "shuffle_type": "rand",
        "starting_epoch": 0,
        "ending_epoch": 50,
        "use": true,

        "use_fsr": true,
        "fsr_lambda_dom": 0.02,
        "fsr_lambda_syn": 0.03,
        "fsr_margin": 0.05,
        "fsr_tau_dom": 10.0,
        "fsr_use_gate": false,
        "fsr_gate_kappa": 5.0,
        "fsr_gate_tau": 1.2,
        "fsr_starting_epoch": 3,
        "fsr_ending_epoch": 12
      },
      "multi_loss": {
        "multi_supervised_w": {
          "combined": 1,
          "c": 1,
          "g": 1
        }
      }
    },
    "load_ongoing": false,
    "save_dir": "MCR_FSR_{}.pth.tar",
    "encoders": [
      {
        "model": "Audio_ResNet",
        "args": {
          "d_model": 512,
          "num_classes": 28,
          "fc_inner": 64,
          "dropout": 0.1,
          "freeze_encoder": false
        },
        "pretrainedEncoder": {
          "use": true,
          "dir": "unimodal_audio_fold{}.pth.tar"
        }
      },
      {
        "model": "Video_ResNet",
        "args": {
          "d_model": 512,
          "num_classes": 28,
          "fc_inner": 64,
          "dropout": 0.1,
          "freeze_encoder": false
        },
        "pretrainedEncoder": {
          "use": true,
          "dir": "unimodal_video_fold{}.pth.tar"
        }
      }
    ]
  }
}