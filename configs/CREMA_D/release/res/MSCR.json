{
  "training_params": {
    "batch_size": 128,
    "test_batch_size": 128,
    "tdqm_disable": false
  },
  "early_stopping": {
    "end_of_epoch_check": true,
    "n_steps_stop": 25,
    "save_every_valstep": 10,
    "validate_every": 25
  },
  "optimizer": {
    "type": "Adam",
    "learning_rate": 0.00001,
    "momentum": 0.9,
    "weight_decay": 0.00001,
    "beta1": 0.9,
    "beta2": 0.999
  },
  "dataset": {
    "norm": false,
    "return_data": {
      "video": true,
      "spectrogram": true,
      "audio": false,
      "face": false
    },
    "sampling_rate": 22050,
    "data_split": {
      "fold": 0
    }
  },
  "model": {
    "model_class": "MCR_Model_FSR",
    "args": {
      "d_model": 512,
      "num_classes": 6,
      "fc_inner": 64,
      "dropout": 0.1,

      "cls_type": "linear",

      "clip_grad": false,
      "batchnorm_features": false,
      "shufflegradmulti": true,

      "bias_infusion": {
        "method": "MCR_FSR",
      
        "reg_by": "dist_pred_cjsd",
        "num_samples": 6,
        "l": 0.1,
        "l_gradnorm": 0,
      
        "shuffle": true,
        "noise": false,
        "shuffle_type": "rand",
      
        "contr_coeff": 1.0,
      
        "starting_epoch": 0,
        "ending_epoch": 100,
      
        "use": true,
        "plot": false,
      
        "use_fsr": true,
      
        "fsr_lambda_dom": 0.02,
        "fsr_lambda_syn": 0.05,
        "fsr_margin": 0.05,
        "fsr_tau_dom": 10.0,
      
        "fsr_use_gate": false,
        "fsr_gate_kappa": 5.0,
        "fsr_gate_tau": 1.2,
      
        "fsr_starting_epoch": 3,
        "fsr_ending_epoch": 12
      },

      "multi_loss": {
        "multi_supervised_w": {
          "combined": 1,
          "c": 1,
          "g": 1
        }
      }
    },
    "load_ongoing": false,
    "save_dir": "MCR_FSR_{}.pth.tar",
    "encoders": [
      {
        "model": "Audio_ResNet",
        "args": {
          "d_model": 512,
          "num_classes": 6,
          "fc_inner": 64,
          "dropout": 0.1,
          "freeze_encoder": false
        },
        "pretrainedEncoder": {
          "use": true,
          "dir": "unimodal_audio_fold{}.pth.tar"
        }
      },
      {
        "model": "Video_ResNet",
        "args": {
          "d_model": 512,
          "num_classes": 6,
          "fc_inner": 64,
          "dropout": 0.1,
          "freeze_encoder": false
        },
        "pretrainedEncoder": {
          "use": true,
          "dir": "unimodal_images_fold{}.pth.tar"
        }
      }
    ]
  }
}